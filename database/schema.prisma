// PHYSICS ACADEMY — data model (v0.3.0)
// Generate the first migration yourself:  npm --workspace services/api run db:migrate -- --name init
// Then apply database/post_migrate.sql (RLS deny-by-default + CHECK constraints).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── enums ─────────────
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  OWNER
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  PRO
  VIP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum AchievementCategory {
  SUBJECT
  MILESTONE
  STREAK
  CHALLENGE
  QUIZ
  TROPHY
}

enum CompetitionStatus {
  DRAFT
  UPCOMING
  LIVE
  ENDED
}

enum NotificationType {
  SYSTEM
  LESSON
  ACHIEVEMENT
  COMPETITION
  REMINDER
}

// ───────────── users ─────────────
model UserProfile {
  id            String    @id @default(cuid())
  authUserId    String    @unique // Supabase auth.users.id
  displayName   String
  role          UserRole  @default(STUDENT)
  grade         String?
  xp            Int       @default(0) // level is derived: highest Level.minXp <= xp. Written by the server only.
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveOn  DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress           LearningProgress[]
  quizAttempts       QuizAttempt[]
  achievements       UserAchievement[]
  studyPlans         StudyPlan[]
  notes              Note[]
  notifications      Notification[]
  subscriptions      Subscription[]
  competitionEntries CompetitionEntry[]
  challengeResults   DailyChallengeCompletion[]
  experimentRuns     ExperimentRun[]
}

model Level {
  id     String @id @default(cuid())
  number Int    @unique // 1..15
  slug   String @unique // e.g. silver, gold ... legend (matches asset names level_NN_<slug>)
  title  String
  minXp  Int    @unique
}

model Subscription {
  id               String             @id @default(cuid())
  userProfileId    String
  tier             SubscriptionTier   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  externalRef      String?            @unique // payment-provider reference, if any

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, status])
}

model Notification {
  id            String           @id @default(cuid())
  userProfileId String
  type          NotificationType @default(SYSTEM)
  title         String
  body          String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, readAt])
}

// ───────────── curriculum ─────────────
model Subject {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)

  units           Unit[]
  experiments     Experiment[]
  dailyChallenges DailyChallenge[]
}

model Unit {
  id        String        @id @default(cuid())
  subjectId String
  title     String
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([subjectId, sortOrder])
}

model Lesson {
  id          String        @id @default(cuid())
  unitId      String
  title       String
  summary     String?       @db.Text
  status      ContentStatus @default(DRAFT)
  sourceTitle String?
  sourceUrl   String? // API must accept https URLs only
  pageNumber  Int?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  unit     Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  progress LearningProgress[]
  quizzes  Quiz[]
  notes    Note[]

  @@index([unitId, sortOrder])
  @@index([status])
}

model LearningProgress {
  id             String   @id @default(cuid())
  userProfileId  String
  lessonId       String
  completionRate Int      @default(0) // 0..100 (CHECK in post_migrate.sql)
  lastPosition   Int      @default(0)
  updatedAt      DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, lessonId])
  @@index([lessonId])
}

model Note {
  id            String   @id @default(cuid())
  userProfileId String
  lessonId      String?
  title         String
  body          String   @db.Text // API enforces a maximum length
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  lesson      Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userProfileId, updatedAt])
  @@index([lessonId])
}

// ───────────── assessment ─────────────
model Quiz {
  id          String        @id @default(cuid())
  lessonId    String?
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  timeLimit   Int? // seconds (CHECK > 0 in post_migrate.sql)
  createdAt   DateTime      @default(now())

  lesson    Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@index([status])
}

model QuizQuestion {
  id          String  @id @default(cuid())
  quizId      String
  prompt      String  @db.Text
  explanation String? @db.Text
  sortOrder   Int     @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId, sortOrder])
}

// SECURITY: isCorrect must never be selected by student-facing queries. Use explicit `select`/DTOs.
model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id            String    @id @default(cuid())
  userProfileId String
  quizId        String
  score         Float?
  maxScore      Float?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userProfileId, startedAt])
  @@index([quizId])
}

// Server-side grading record: the client submits optionId, the server fills isCorrect.
model QuizAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  isCorrect  Boolean  @default(false)
  answeredAt DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([optionId])
}

// ───────────── rewards & competition ─────────────
model Achievement {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String?
  category    AchievementCategory @default(MILESTONE)
  points      Int                 @default(0)
  icon        String?

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userProfileId String
  achievementId String
  awardedAt     DateTime @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, achievementId])
  @@index([achievementId])
}

model Competition {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  status      CompetitionStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime // CHECK endsAt > startsAt in post_migrate.sql
  createdAt   DateTime          @default(now())

  entries CompetitionEntry[]

  @@index([status, startsAt])
}

// Scores are computed by the server from graded results, never accepted from the client.
model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  userProfileId String
  score         Int      @default(0)
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userProfileId])
  @@index([competitionId, score])
  @@index([userProfileId])
}

model DailyChallenge {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  subjectId String?
  title     String
  payload   Json?

  subject     Subject?                   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  completions DailyChallengeCompletion[]

  @@index([subjectId])
}

model DailyChallengeCompletion {
  id            String   @id @default(cuid())
  challengeId   String
  userProfileId String
  completedAt   DateTime @default(now())

  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userProfile UserProfile    @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userProfileId])
  @@index([userProfileId])
}

// ───────────── labs ─────────────
model Experiment {
  id          String        @id @default(cuid())
  subjectId   String
  slug        String        @unique
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)

  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  runs    ExperimentRun[]

  @@index([subjectId, sortOrder])
}

model ExperimentRun {
  id            String    @id @default(cuid())
  experimentId  String
  userProfileId String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  experiment  Experiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([userProfileId, startedAt])
}

// ───────────── planning ─────────────
model StudyPlan {
  id            String   @id @default(cuid())
  userProfileId String
  title         String
  targetMinutes Int      @default(30) // CHECK 1..1440 in post_migrate.sql
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, active])
}
