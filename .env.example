# ── API (services/api) ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated explicit origins. Wildcards are rejected. https is REQUIRED when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# Number of reverse-proxy hops in front of the API (0 = none). Needed for correct per-IP rate limiting behind a proxy.
TRUST_PROXY_HOPS=0
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# ── Auth (server-side ONLY — never prefix with NEXT_PUBLIC_) ─────
# Supabase project JWT secret. Min 32 chars. REQUIRED in production; also used by apps/admin-web middleware.
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated
JWT_ISSUER=
# apps/admin-web: set to true to enforce auth in development too (production always enforces it).
ADMIN_REQUIRE_AUTH=false

# ── Database (Supabase / PostgreSQL) ─────────────────────────────
DATABASE_URL=
DIRECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Public web config (safe to expose to the browser) ────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI provider — keep secret keys server-side only ──────────────
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
